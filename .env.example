# PricesAPI.io API keys (round-robin rotation across accounts)
# Copy this file to .env and fill in your real keys.
# Get keys at https://pricesapi.io/

PRICESAPI_KEY_1=your_pricesapi_key_here
PRICESAPI_KEY_2=your_pricesapi_key_here
PRICESAPI_KEY_3=your_pricesapi_key_here
PRICESAPI_KEY_4=your_pricesapi_key_here
PRICESAPI_KEY_5=your_pricesapi_key_here

# Required for FX normalization (exchangerate.host / APILayer)
EXCHANGERATE_HOST_ACCESS_KEY=your_access_key_here
